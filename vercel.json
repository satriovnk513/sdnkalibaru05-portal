{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "https://wwpbghdepykfqgzhyvmh.supabase.co/storage/v1/object/public/photos/logo.ico"
    },
    {
      "source": "/berita/:slug",
      "destination": "/berita-detail.html?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
